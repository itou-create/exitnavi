# 公共交通オープンデータセンター（ODPT）のアクセストークン
# https://developer.odpt.org/ で取得する
#
# このファイルを .env.local にコピーして値を入れる。
# 未設定の場合はモックデータで動作するので、キーがなくても開発できる。
#
# .env.local は絶対にコミットしないこと（.gitignore 済み）

VITE_ODPT_TOKEN=

# true にすると、トークンがあっても強制的にモックを使う。
# 深夜・早朝など列車が走っていない時間帯の開発／デモで使う。
VITE_FORCE_MOCK=false

# Google Places API (New) のキー。目的地のフリーワード検索に使う。
# 未設定なら検索欄が出ないだけで、プリセットの目的地で全画面が動く。
#
# ⚠️ このキーは公開サイトのJSに埋め込まれる。Google Cloud 側で必ず
#    「HTTPリファラ制限（本番URLと localhost）＋ Places API (New) のみ」に制限すること。
# 本番ビルド用は GitHub リポジトリの Secrets（VITE_GOOGLE_PLACES_KEY）に入れる。
VITE_GOOGLE_PLACES_KEY=
